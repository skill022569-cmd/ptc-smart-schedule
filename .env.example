# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (ห้าม commit ไฟล์ .env ขึ้น GitHub)

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ใส่-service_role-key

# สร้างด้วยคำสั่ง: npm run gen-keys
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# บัญชีผู้ดูแลระบบคนแรก (ใช้ตอน npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2569
ADMIN_EMAIL=admin@pticec.ac.th

# 2FA: true = ส่ง OTP ทางอีเมลทุกครั้งที่ล็อกอิน, false = ปิด
OTP_REQUIRED=true

# ส่ง OTP ทางอีเมล (SMTP) — Google Workspace ของวิทยาลัย: smtp.gmail.com พอร์ต 465 + App Password
# ถ้าเว้นว่าง OTP จะแสดงใน log ของเซิร์ฟเวอร์ (โหมดทดสอบ)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

PORT=3000
NODE_ENV=development
