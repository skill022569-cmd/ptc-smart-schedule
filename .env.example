# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (ห้าม commit ไฟล์ .env ขึ้น GitHub)

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ใส่-service_role-key

# สร้างด้วยคำสั่ง: npm run gen-keys
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# บัญชีผู้ดูแลระบบคนแรก (ใช้ตอน npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2569
ADMIN_PHONE=

# 2FA: true = ส่ง OTP ทุกครั้งที่ผู้ใช้มีเบอร์โทร, false = ปิด
OTP_REQUIRED=true

# ThaiBulkSMS (ถ้าเว้นว่าง OTP จะแสดงใน log ของเซิร์ฟเวอร์ = โหมดทดสอบ)
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
THAIBULKSMS_SENDER=

PORT=3000
NODE_ENV=development
